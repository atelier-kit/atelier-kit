{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atelier protocol task",
  "type": "object",
  "required": ["id", "type", "status", "artifact"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "enum": [
        "questions",
        "research",
        "repo",
        "tech",
        "business",
        "synthesis",
        "design",
        "planning",
        "review"
      ],
      "$comment": "repo/tech/business/synthesis are legacy task types kept for ledgers created before research consolidation"
    },
    "status": { "enum": ["pending", "in_progress", "done", "blocked"] },
    "artifact": { "type": "string", "minLength": 1 }
  }
}
